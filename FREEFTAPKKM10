local currentBlobman = nil
local maxRetries = 5
local TP_WAIT = 0.02
local GRAB_WAIT = 0.005

local function MountBlobman(blobman)
    if not blobman then
        return false
    end
    local char = LocalPlayer.Character
    if not char then
        return false
    end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return false
    end
    if humanoid.SeatPart and humanoid.SeatPart.Parent == blobman then
        return true
    end
    local seat = blobman:FindFirstChild("VehicleSeat")
    if not seat then
        for _, child in ipairs(blobman:GetDescendants()) do
            if child:IsA("VehicleSeat") or child:IsA("Seat") then
                seat = child
                break
            end
        end
    end
    if not seat then
        return false
    end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        return false
    end
    rootPart.CFrame = seat.CFrame + Vector3.new(0, 1.5, 0)
    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
    task.wait(0.1)
    for i = 1, 5 do
        pcall(function()
            seat:Sit(humanoid)
        end)
        task.wait(0.1)
        if humanoid.SeatPart == seat then
            return true
        end
        rootPart.CFrame = seat.CFrame + Vector3.new(0, 1.5 + (i * 0.2), 0)
        task.wait(0.1)
    end
    return humanoid.SeatPart == seat
end

local function GetSeatedBlobman()
    local char = LocalPlayer.Character
    if not char then
        return nil
    end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return nil
    end
    local seat = humanoid.SeatPart
    if not seat or not seat:IsA("VehicleSeat") then
        return nil
    end
    local obj = seat
    while obj do
        if obj:IsA("Model") and obj.Name == "CreatureBlobman" then
            return obj
        end
        obj = obj.Parent
    end
    return nil
end

local function SpawnBlobman()
    local seated = GetSeatedBlobman()
    if seated then
        currentBlobman = seated
        return seated
    end
    if currentBlobman and currentBlobman.Parent then
        local blobPos = nil
        if currentBlobman.PrimaryPart then
            blobPos = currentBlobman.PrimaryPart.Position
        else
            local part = currentBlobman:FindFirstChildWhichIsA("BasePart")
            if part then
                blobPos = part.Position
            end
        end
        local rootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local localPos = rootPart and rootPart.Position
        if blobPos and localPos and (blobPos - localPos).Magnitude < 500 then
            if MountBlobman(currentBlobman) then
                return currentBlobman
            end
        else
            pcall(function()
                currentBlobman:Destroy()
            end)
            currentBlobman = nil
        end
    end
    local char = LocalPlayer.Character
    if not char then
        return nil
    end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        return nil
    end
    local spawnRemote = ReplicatedStorage:FindFirstChild("MenuToys") and ReplicatedStorage.MenuToys:FindFirstChild("SpawnToyRemoteFunction")
    if not spawnRemote then
        return nil
    end
    local blobman = nil
    for attempt = 1, 5 do
        local spawnPos = rootPart.CFrame * CFrame.new(0, 0, -5)
        pcall(function()
            spawnRemote:InvokeServer("CreatureBlobman", spawnPos, Vector3.new(0, 127, 0))
        end)
        task.wait(0.3)
        local toyFolder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        if toyFolder then
            blobman = toyFolder:FindFirstChild("CreatureBlobman")
            if blobman then
                currentBlobman = blobman
                break
            end
        end
        task.wait(0.2)
    end
    if not blobman then
        return nil
    end
    currentBlobman = blobman
    if MountBlobman(blobman) then
        return blobman
    end
    for retry = 1, 3 do
        pcall(function()
            local destroyToy = ReplicatedStorage:FindFirstChild("MenuToys") and ReplicatedStorage.MenuToys:FindFirstChild("DestroyToy")
            if destroyToy and blobman then
                destroyToy:FireServer(blobman)
            end
        end)
        task.wait(0.3)
        local spawnPos = rootPart.CFrame * CFrame.new(0, 0, -5)
        pcall(function()
            spawnRemote:InvokeServer("CreatureBlobman", spawnPos, Vector3.new(0, 127, 0))
        end)
        task.wait(0.3)
        local toyFolder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        if toyFolder then
            blobman = toyFolder:FindFirstChild("CreatureBlobman")
            if blobman then
                currentBlobman = blobman
                if MountBlobman(blobman) then
                    return blobman
                end
            end
        end
    end
    return nil
end

local function GrabRelease(blob, targetRoot)
    if not blob or not targetRoot then
        return
    end
    pcall(function()
        local sc = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
        if not sc then
            return
        end
        local leftDet = blob:FindFirstChild("LeftDetector")
        local leftWeld = leftDet and leftDet:FindFirstChild("LeftWeld")
        if sc:FindFirstChild("CreatureGrab") and leftDet and leftWeld then
            sc.CreatureGrab:FireServer(leftDet, targetRoot, leftWeld)
        end
        if sc:FindFirstChild("CreatureRelease") and leftWeld then
            sc.CreatureRelease:FireServer(leftWeld)
        end
    end)
end

local function KillPlayer(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then
        return false
    end
    local humanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return false
    end
    for _ = 1, maxRetries do
        local ok = pcall(function()
            humanoid.BreakJointsOnDeath = false
            humanoid:ChangeState(Enum.HumanoidStateType.Dead)
        end)
        if ok and humanoid.Health <= 0 then
            return true
        end
        task.wait(0.005)
    end
    return false
end

