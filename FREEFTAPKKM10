local boardPalette = nil
local boardControlBP = nil
local boardPaletteConn = nil
local boardSpawning = false
local createLineRemote = GrabEvents and GrabEvents:FindFirstChild("CreateGrabLine")
local setOwnerRemote = GrabEvents and GrabEvents:FindFirstChild("SetNetworkOwner")
local spawnToyRemote = ReplicatedStorage:FindFirstChild("MenuToys") and ReplicatedStorage.MenuToys:FindFirstChild("SpawnToyRemoteFunction")

local function startBoardLagSpam()
    if boardLagRunning then
        return
    end
    boardLagRunning = true
    task.spawn(function()
        while boardLagRunning do
            local spawnLocation = Workspace:FindFirstChild("SpawnLocation")
                or Workspace:FindFirstChild("Spawn")
                or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
            if spawnLocation and createLineRemote then
                pcall(function()
                    createLineRemote:FireServer(spawnLocation, CFrame.new(math.random(-2010000000, 2000000001), 0, math.random(-2008100000, 2000200000)))
                end)
            end
            task.wait()
        end
    end)
end

local function stopBoardLagSpam()
    boardLagRunning = false
end

local function boardFindFirst(obj, name, timeout)
    return obj:FindFirstChild(name) or obj:WaitForChild(name, timeout or 5)
end

local function boardHasPartOwner(part)
    return part and part:FindFirstChild("PartOwner") ~= nil
end

local function boardSetOwner(part)
    if part and part:IsA("BasePart") and setOwnerRemote then
        pcall(function()
            setOwnerRemote:FireServer(part, part.CFrame)
        end)
        task.wait()
    end
end

-- 板五人キック相当のロバストなスポーン（単体用）
local function spawnPalette()
    if boardSpawning then
        return nil
    end
    if not spawnToyRemote then
        return nil
    end
    boardSpawning = true

    local char = LocalPlayer.Character
    if not char then
        boardSpawning = false
        return nil
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        boardSpawning = false
        return nil
    end

    -- CanSpawnToy / InPlot 待機（板五人キック互換）
    local waitCount = 0
    pcall(function()
        while (LocalPlayer:FindFirstChild("InPlot") and LocalPlayer.InPlot.Value and LocalPlayer:FindFirstChild("InOwnedPlot") and not LocalPlayer.InOwnedPlot.Value) and waitCount < 50 do
            task.wait(0.1)
            waitCount = waitCount + 1
        end
        waitCount = 0
        while LocalPlayer:FindFirstChild("CanSpawnToy") and not LocalPlayer.CanSpawnToy.Value and waitCount < 50 do
            task.wait(0.1)
            waitCount = waitCount + 1
        end
    end)

    local spawnCF = hrp.CFrame * CFrame.new(0, 14, 20)

    local toyFolder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    if not toyFolder then
        local plotItems = Workspace:FindFirstChild("PlotItems")
        if plotItems then
            toyFolder = plotItems:FindFirstChild("Plot1")
        end
    end
    if not toyFolder then
        toyFolder = Workspace
    end

    local palette = nil
    local conn = toyFolder.ChildAdded:Connect(function(obj)
        if obj.Name == "PalletLightBrown" then
            palette = obj
        end
    end)

    pcall(function()
        spawnToyRemote:InvokeServer("PalletLightBrown", spawnCF, Vector3.zero)
    end)

    local t0 = tick()
    repeat
        task.wait(0.05)
    until palette or (tick() - t0) > 5
    conn:Disconnect()

    if not palette then
        boardSpawning = false
        return nil
    end

    local soundPart = boardFindFirst(palette, "SoundPart", 3)
    if not soundPart then
        pcall(function() palette:Destroy() end)
        boardSpawning = false
        return nil
    end

    local retryCount = 0
    while retryCount < 10 do
        if not boardKickRunning then
            pcall(function() palette:Destroy() end)
            boardSpawning = false
            return nil
        end
        boardSetOwner(soundPart)
        if boardHasPartOwner(soundPart) then
            break
        end
        retryCount = retryCount + 1
    end

    if not boardHasPartOwner(soundPart) then
        pcall(function() palette:Destroy() end)
        boardSpawning = false
        return nil
    end

    for _, p in pairs(palette:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CanCollide = false
            p.Transparency = 0.8
        end
    end
    palette.Name = "RagdollPalete"

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(0, math.huge, 0)
    bv.Velocity = Vector3.new(0, 900, 0)
    bv.Parent = soundPart

    boardSpawning = false
    return palette
end

-- 距離が遠い場合に一時接近してオーナーシップ連打（板五人キックの aa25 相当）
local function boardThrowApproach(targetPlayer, myRoot)
    if not targetPlayer or not targetPlayer.Character or not myRoot then
        return
    end
    local tRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not tRoot then
        return
    end
    local saved = myRoot.CFrame
    myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 2)
    for i = 1, 15 do
        if setOwnerRemote then
            pcall(function()
                setOwnerRemote:FireServer(tRoot, tRoot.CFrame)
            end)
        end
        task.wait()
    end
    myRoot.CFrame = saved
end

local function cleanupBoardKick()
    stopBoardLagSpam()
    if boardPaletteConn then
        pcall(function() boardPaletteConn:Disconnect() end)
        boardPaletteConn = nil
    end
    if boardControlBP then
        pcall(function() boardControlBP:Destroy() end)
        boardControlBP = nil
    end
    if boardPalette then
        pcall(function() boardPalette:Destroy() end)
        boardPalette = nil
    end
    boardSpawning = false
end

KillGroup:AddToggle("BoardKickToggle", {
    Text = "板キック (単体)",
    Default = false,
    Callback = function(v)
        boardKickRunning = v
        if v then
            startBoardLagSpam()

            -- メイン制御ループ（BodyPosition + 距離チェック）
            task.spawn(function()
                local circleHeight = 8
                local maxDist = 25

                while boardKickRunning do
                    if selectedTargetName == "" then
                        task.wait()
                        continue
                    end
                    local target = Players:FindFirstChild(selectedTargetName)
                    if not target or not target.Character then
                        task.wait()
                        continue
                    end
                    local myChar = LocalPlayer.Character
                    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
                    local tHum = target.Character:FindFirstChildOfClass("Humanoid")
                    if not myRoot or not tRoot or not tHum then
                        task.wait()
                        continue
                    end

                    local dist = (myRoot.Position - tRoot.Position).Magnitude
                    if dist > maxDist then
                        boardThrowApproach(target, myRoot)
                    end

                    if setOwnerRemote then
                        pcall(function()
                            setOwnerRemote:FireServer(tRoot, tRoot.CFrame)
                        end)
                    end
                    if GrabEvents and GrabEvents:FindFirstChild("DestroyGrabLine") then
                        pcall(function()
                            GrabEvents.DestroyGrabLine:FireServer(tRoot)
                        end)
                    end

                    tRoot.AssemblyLinearVelocity = Vector3.zero
                    tRoot.AssemblyAngularVelocity = Vector3.zero

                    if not boardControlBP or not boardControlBP:IsDescendantOf(Workspace) then
                        boardControlBP = Instance.new("BodyPosition")
                        boardControlBP.Name = "ControlBP"
                        boardControlBP.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                        boardControlBP.P = 800000
                        boardControlBP.Parent = tRoot
                    end
                    boardControlBP.Position = myRoot.Position + Vector3.new(0, circleHeight, 0)

                    task.wait()
                end

                cleanupBoardKick()
            end)

            -- パレット連続管理（RenderStepped / 板五人キック相当）
            if boardPaletteConn then
                pcall(function() boardPaletteConn:Disconnect() end)
                boardPaletteConn = nil
            end
            boardPaletteConn = RunService.RenderStepped:Connect(function()
                if not boardKickRunning then
                    return
                end
                if selectedTargetName == "" then
                    if boardPalette and boardPalette:IsDescendantOf(Workspace) then
                        pcall(function() boardPalette:Destroy() end)
                    end
                    boardPalette = nil
                    return
                end
                local target = Players:FindFirstChild(selectedTargetName)
                if not target or not target.Character then
                    if boardPalette and boardPalette:IsDescendantOf(Workspace) then
                        pcall(function() boardPalette:Destroy() end)
                    end
                    boardPalette = nil
                    return
                end
                local hrp = target.Character:FindFirstChild("HumanoidRootPart")
                local hum = target.Character:FindFirstChildOfClass("Humanoid")
                if not hrp or not hum then
                    if boardPalette and boardPalette:IsDescendantOf(Workspace) then
                        pcall(function() boardPalette:Destroy() end)
                    end
                    boardPalette = nil
                    return
                end

                if boardPalette and boardPalette:IsDescendantOf(Workspace) then
                    local soundPart = boardPalette:FindFirstChild("SoundPart")
                    if soundPart and not boardHasPartOwner(soundPart) then
                        pcall(function() boardPalette:Destroy() end)
                        boardPalette = nil
                    end
                end

                if not boardSpawning and (not boardPalette or not boardPalette:IsDescendantOf(Workspace)) then
                    local newPalette = spawnPalette()
                    if newPalette then
                        boardPalette = newPalette
                    end
                end

                if boardPalette and boardPalette:IsDescendantOf(Workspace) then
                    local soundPart = boardPalette:FindFirstChild("SoundPart")
                    if soundPart then
                        local ragdolled = hum:FindFirstChild("Ragdolled")
                        if ragdolled and not ragdolled.Value then
                            soundPart.Position = hrp.Position
                        end
                    end
                end
            end)
        else
            cleanupBoardKick()
        end
    end
})

-- Drift Kick (tanpopo-style blob logic, adjustable rotation speed only, regrab=3.5s)
local driftRunning = false
local driftLoopId = 0
local driftAngle = 0
local driftSpeed = 12  -- rotation speed only (adjustable via slider)

KillGroup:AddSlider("DriftSpeedSlider", {
    Text = "Drift 回転速度",
    Default = 12,
    Min = 1,
    Max = 50,
    Rounding = 1,
    Callback = function(Value)
        driftSpeed = Value
    end
})

KillGroup:AddToggle("DriftKickToggle", {
    Text = "Drift Kick",
    Default = false,
    Callback = function(v)
        driftRunning = v
        driftLoopId = driftLoopId + 1
        local myLoopId = driftLoopId
        if not v then
            return
        end
        if selectedTargetName == "" then
            Library:Notify({
                Title = "Drift",
                Description = "ターゲット未選択",
                Time = 2
            })
            driftRunning = false
            return
        end
        local target = Players:FindFirstChild(selectedTargetName)
        if not target then
            Library:Notify({
                Title = "Drift",
                Description = "ターゲット無効",
                Time = 2
            })
            driftRunning = false
            return
        end
        task.spawn(function()
            -- 確実起動: Blobmanリトライ強化（たんぽぽ風）
            local blobman = nil
            for attempt = 1, 12 do
                blobman = SpawnBlobman()
                if blobman and blobman.Parent then
                    break
                end
                task.wait(0.35)
            end
            if not blobman or not blobman.Parent then
                Library:Notify({
                    Title = "Drift",
                    Description = "Blobman失敗",
                    Time = 2
                })
                driftRunning = false
                return
            end

            local scriptObj = blobman:FindFirstChild("BlobmanSeatAndOwnerScript")
            if not scriptObj then
                -- 待機して再取得
                for _ = 1, 20 do
                    task.wait(0.1)
                    scriptObj = blobman:FindFirstChild("BlobmanSeatAndOwnerScript")
                    if scriptObj then break end
                end
            end
            local grabRemote = scriptObj and scriptObj:FindFirstChild("CreatureGrab")
            local releaseRemote = scriptObj and scriptObj:FindFirstChild("CreatureRelease")
            local dropRemote = scriptObj and scriptObj:FindFirstChild("CreatureDrop")
            local lDet = blobman:FindFirstChild("LeftDetector")
            local rDet = blobman:FindFirstChild("RightDetector")
            local lWeld = lDet and (lDet:FindFirstChild("LeftWeld") or lDet:FindFirstChild("RigidConstraint"))
            local rWeld = rDet and (rDet:FindFirstChild("RightWeld") or rDet:FindFirstChild("RigidConstraint"))
            local Det = rDet or lDet
            local Weld = rWeld or lWeld
            local GE = GrabEvents

            if not (GE and grabRemote and Det and Weld) then
                Library:Notify({
                    Title = "Drift",
                    Description = "Remote不足",
                    Time = 2
                })
                driftRunning = false
                return
            end

            Library:Notify({
                Title = "Drift",
                Description = "開始 (回転速度=" .. tostring(driftSpeed) .. ")",
                Time = 2
            })

            local radius = 19
            local heightOffset = 0
            local regrabInterval = 3.5  -- 掴み直し速度は3.5固定（回転速度のみ調整可）
            local blobRoot = blobman:FindFirstChild("HumanoidRootPart") or blobman.PrimaryPart

            -- たんぽぽ風: Grab + Release を連続で実行するヘルパー
            local function tanpopoGrabRelease(targetRoot)
                if not targetRoot or not blobman or not blobman.Parent then return end
                pcall(function()
                    if grabRemote and lDet and lWeld then
                        grabRemote:FireServer(lDet, targetRoot, lWeld)
                    end
                    if releaseRemote and lWeld then
                        releaseRemote:FireServer(lWeld)
                    elseif dropRemote and lWeld then
                        dropRemote:FireServer(lWeld)
                    end
                end)
            end

            local function tanpopoBothArmsGrab(targetRoot)
                if not targetRoot or not blobman or not blobman.Parent then return end
                pcall(function()
                    if grabRemote and lDet and lWeld then
                        grabRemote:FireServer(lDet, targetRoot, lWeld)
                    end
                    if grabRemote and rDet and rWeld then
                        grabRemote:FireServer(rDet, targetRoot, rWeld)
                    end
                end)
            end

            while driftRunning and myLoopId == driftLoopId do
                if not target or not target.Parent then
                    break
                end
                local tChar = target.Character
                local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
                local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                if tChar and tRoot and tHum and tHum.Health > 0 then
                    -- ===== Bring phase: たんぽぽ風に接近して連続Grab+Release =====
                    local bringStart = tick()
                    while tick() - bringStart < 0.40 do
                        if myLoopId ~= driftLoopId or not driftRunning then
                            break
                        end
                        if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                            local currentTRoot = target.Character.HumanoidRootPart
                            if blobRoot then
                                blobRoot.CFrame = currentTRoot.CFrame
                                blobRoot.AssemblyLinearVelocity = Vector3.zero
                            end
                            pcall(function()
                                tanpopoGrabRelease(currentTRoot)
                                if GE:FindFirstChild("CreateGrabLine") then
                                    GE.CreateGrabLine:FireServer(currentTRoot, Vector3.zero, currentTRoot.Position, false)
                                end
                                if GE:FindFirstChild("SetNetworkOwner") then
                                    GE.SetNetworkOwner:FireServer(currentTRoot, blobRoot and blobRoot.CFrame or currentTRoot.CFrame)
                                end
                            end)
                        end
                        RunService.Heartbeat:Wait()
                    end
                    if myLoopId ~= driftLoopId or not driftRunning then
                        break
                    end

                    tChar = target.Character
                    tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                    tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
                    if tChar and tRoot and tHum and tHum.Health > 0 then
                        local SavedPos = tRoot.CFrame
                        local targetCenterCFrame = SavedPos + Vector3.new(0, 30, 0)
                        local lastTime = tick()
                        local lastRegrabTime = tick()

                        while driftRunning and blobman and blobman.Parent and myLoopId == driftLoopId do
                            if not target or not target.Parent then
                                break
                            end
                            tChar = target.Character
                            tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                            tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
                            if not tChar or not tRoot or not tHum or tHum.Health <= 0 then
                                break
                            end

                            -- 掴み直し（3.5秒固定）: たんぽぽ風 Grab+Release → 再Grab
                            if (tick() - lastRegrabTime) > regrabInterval then
                                pcall(function()
                                    if GE:FindFirstChild("DestroyGrabLine") then
                                        GE.DestroyGrabLine:FireServer(tRoot)
                                    end
                                    if dropRemote and rWeld then
                                        dropRemote:FireServer(rWeld)
                                    end
                                    if releaseRemote and lWeld then
                                        releaseRemote:FireServer(lWeld)
                                    end
                                end)
                                if blobRoot then
                                    blobRoot.CFrame = SavedPos
                                    blobRoot.AssemblyLinearVelocity = Vector3.zero
                                end
                                RunService.Heartbeat:Wait()
                                if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                                    local currentTRoot = target.Character.HumanoidRootPart
                                    if blobRoot then
                                        blobRoot.CFrame = currentTRoot.CFrame
                                        blobRoot.AssemblyLinearVelocity = Vector3.zero
                                    end
                                    -- たんぽぽ風: 連続Grab+Releaseを数回
                                    for _ = 1, 6 do
                                        tanpopoGrabRelease(currentTRoot)
                                        if GE:FindFirstChild("CreateGrabLine") then
                                            pcall(function()
                                                GE.CreateGrabLine:FireServer(currentTRoot, Vector3.zero, currentTRoot.Position, false)
                                            end)
                                        end
                                        if GE:FindFirstChild("SetNetworkOwner") then
                                            pcall(function()
                                                GE.SetNetworkOwner:FireServer(currentTRoot, blobRoot and blobRoot.CFrame or currentTRoot.CFrame)
                                            end)
                                        end
                                        RunService.Heartbeat:Wait()
                                    end
                                    -- 両腕掴み（たんぽぽ最終フェーズ相当）
                                    tanpopoBothArmsGrab(currentTRoot)
                                end
                                lastTime = tick()
                                lastRegrabTime = tick()
                            else
                                -- 軌道フェーズ: 回転速度のみ可変
                                local currentTime = tick()
                                local dt = currentTime - lastTime
                                lastTime = currentTime
                                local currentSpeed = driftSpeed
                                driftAngle = driftAngle + (currentSpeed * dt)
                                local offsetX = math.cos(driftAngle) * radius
                                local offsetZ = math.sin(driftAngle) * radius
                                if blobRoot then
                                    local blobPos = targetCenterCFrame.Position + Vector3.new(offsetX, heightOffset, offsetZ)
                                    blobRoot.CFrame = CFrame.new(blobPos, targetCenterCFrame.Position)
                                    blobRoot.AssemblyLinearVelocity = Vector3.zero
                                    blobRoot.AssemblyAngularVelocity = Vector3.zero
                                end
                                tRoot.CFrame = targetCenterCFrame
                                tRoot.AssemblyLinearVelocity = Vector3.zero
                                tRoot.AssemblyAngularVelocity = Vector3.zero
                                pcall(function()
                                    tHum.PlatformStand = true
                                    tHum.Sit = true
                                    if GE:FindFirstChild("SetNetworkOwner") then
                                        GE.SetNetworkOwner:FireServer(tRoot, targetCenterCFrame)
                                    end
                                    -- 軌道中も軽くGrab維持（たんぽぽ風）
                                    if Det and Weld and grabRemote then
                                        grabRemote:FireServer(Det, tRoot, Weld)
                                    end
                                    if GE:FindFirstChild("DestroyGrabLine") then
                                        GE.DestroyGrabLine:FireServer(tRoot)
                                    end
                                    if GE:FindFirstChild("CreateGrabLine") then
                                        GE.CreateGrabLine:FireServer(tRoot, Vector3.zero, targetCenterCFrame.Position, false)
                                    end
                                end)
                            end
                            RunService.Heartbeat:Wait()
                        end
                    end
                end
                RunService.Heartbeat:Wait()
            end
        end)
    end
})

-- Spam Kick
local spamKickActive = false
local spamKickTask = nil
local spamMainTask = nil
local spamBodyPos = nil
local spamBodyGyro = nil
local spamSavedPos = nil
local spamDragging = false
local spamGrabStart = 0
local spamCheckStart = 0
local spamNoclipConn = nil

local function SetSpamNoclip(enabled)
    if spamNoclipConn then
        spamNoclipConn:Disconnect()
        spamNoclipConn = nil
    end
    if enabled then
        spamNoclipConn = RunService.Stepped:Connect(function()
            if LocalPlayer.Character then
                for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    end
end

local function CleanupSpamBodies()
    if spamBodyPos then
        pcall(function()
            spamBodyPos:Destroy()
        end)
        spamBodyPos = nil
    end
    if spamBodyGyro then
        pcall(function()
            spamBodyGyro:Destroy()
        end)
        spamBodyGyro = nil
    end
end

local function StopSpamKick()
    spamKickActive = false
    if spamKickTask then
        task.cancel(spamKickTask)
        spamKickTask = nil
    end
    if spamMainTask then
        task.cancel(spamMainTask)
        spamMainTask = nil
    end
    CleanupSpamBodies()
    SetSpamNoclip(false)
    spamDragging = false
    spamGrabStart = 0
    spamCheckStart = 0
end

local function CreateSpamBodies(targetRoot, pos)
    CleanupSpamBodies()
    spamBodyPos = Instance.new("BodyPosition")
    spamBodyPos.MaxForce = Vector3.new(1e8, 1e8, 1e8)
    spamBodyPos.P = 100000
    spamBodyPos.D = 1000
    spamBodyPos.Position = pos
    spamBodyPos.Parent = targetRoot
    spamBodyGyro = Instance.new("BodyGyro")
    spamBodyGyro.MaxTorque = Vector3.new(1e8, 1e8, 1e8)
    spamBodyGyro.P = 100000
    spamBodyGyro.D = 1000
    spamBodyGyro.CFrame = CFrame.new(pos)
    spamBodyGyro.Parent = targetRoot
end

KillGroup:AddToggle("SpamKickToggle", {
    Text = "Spam Kick",
    Default = false,
    Callback = function(v)
        if v then
            if selectedTargetName == "" then
                Library:Notify({
                    Title = "Spam",
                    Description = "ターゲット未選択",
                    Time = 2
                })
                return
            end
            local target = Players:FindFirstChild(selectedTargetName)
            if not target then
                Library:Notify({
                    Title = "Spam",
                    Description = "ターゲット無効",
                    Time = 2
                })
                return
            end
            StopSpamKick()
            spamKickActive = true
            SetSpamNoclip(true)
            spamMainTask = task.spawn(function()
                local myChar = LocalPlayer.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if not myRoot then
                    StopSpamKick()
                    return
                end
                spamSavedPos = myRoot.CFrame
                spamDragging = false
                spamGrabStart = 0
                spamCheckStart = 0
                local spamKickRunning = false
                while spamKickActive do
                    local currentTarget = Players:FindFirstChild(selectedTargetName)
                    if not currentTarget then
                        CleanupSpamBodies()
                        spamKickRunning = false
                        task.wait()
                        continue
                    end
                    myChar = LocalPlayer.Character
                    myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    local tChar = currentTarget.Character
                    local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                    local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
                    if tRoot and tHum and tHum.Health > 0 and myRoot then
                        if not spamKickRunning then
                            spamKickRunning = true
                            spamKickTask = task.spawn(function()
                                while spamKickActive and tRoot and tRoot.Parent do
                                    if GrabEvents and GrabEvents:FindFirstChild("DestroyGrabLine") then
                                        pcall(function()
                                            GrabEvents.DestroyGrabLine:FireServer(tRoot)
                                        end)
                                    end
                                    task.wait()
                                    if GrabEvents and GrabEvents:FindFirstChild("SetNetworkOwner") then
                                        pcall(function()
                                            GrabEvents.SetNetworkOwner:FireServer(tRoot, tRoot.CFrame)
                                        end)
                                    end
                                    task.wait()
                                end
                            end)
                        end
                        if not spamDragging then
                            myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
                            CleanupSpamBodies()
                            spamCheckStart = 0
                            pcall(function()
                                if GrabEvents and GrabEvents:FindFirstChild("SetNetworkOwner") then
                                    GrabEvents.SetNetworkOwner:FireServer(tRoot, tRoot.CFrame)
                                    GrabEvents.SetNetworkOwner:FireServer(tRoot, tRoot.CFrame)
                                end
                                if GrabEvents and GrabEvents:FindFirstChild("DestroyGrabLine") then
                                    GrabEvents.DestroyGrabLine:FireServer(tRoot)
                                end
                            end)
                            myRoot.AssemblyLinearVelocity = Vector3.zero
                            myRoot.AssemblyAngularVelocity = Vector3.zero
                            if spamGrabStart == 0 then
                                spamGrabStart = tick()
                            end
                            if tick() - spamGrabStart > 0.35 then
                                spamDragging = true
                                spamGrabStart = 0
                                spamCheckStart = tick()
                                local lockPos = spamSavedPos * CFrame.new(0, 17, 0)
                                CreateSpamBodies(tRoot, lockPos.Position)
                            end
                        else
                            myRoot.CFrame = spamSavedPos
                            local lockPos = spamSavedPos * CFrame.new(0, 17, 0)
                            myRoot.AssemblyLinearVelocity = Vector3.zero
                            myRoot.AssemblyAngularVelocity = Vector3.zero
                            if spamBodyPos and spamBodyPos.Parent then
                                spamBodyPos.Position = lockPos.Position
                                if spamBodyGyro then
                                    spamBodyGyro.CFrame = lockPos
                                end
                            else
                                CreateSpamBodies(tRoot, lockPos.Position)
                            end
                            if spamCheckStart > 0 and tick() - spamCheckStart > 0.30 then
                                local currentDist = (tRoot.Position - lockPos.Position).Magnitude
                                if currentDist > 10 then
                                    spamDragging = false
                                    spamGrabStart = 0
                                    spamCheckStart = 0
                                    CleanupSpamBodies()
                                    myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
                                else
                                    spamCheckStart = tick()
                                end
                            end
                        end
                    else
                        spamDragging = false
                        spamGrabStart = 0
                        spamCheckStart = 0
                        CleanupSpamBodies()
                        spamKickRunning = false
                    end
                    task.wait()
                end
                CleanupSpamBodies()
                SetSpamNoclip(false)
            end)
        else
            StopSpamKick()
        end
    end
})

