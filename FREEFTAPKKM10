local function IsPCLDTarget(obj)
    if not obj:IsA("BasePart") then
        return false
    end
    for _, name in ipairs(PCLDEsp.targetNames) do
        if string.lower(obj.Name) == string.lower(name) then
            return true
        end
    end
    return false
end

local function AddPCLDBox(obj)
    if PCLDEsp.boxes[obj] then
        return
    end
    local box = Instance.new("BoxHandleAdornment")
    box.Name = "PCLDBox"
    box.Adornee = obj
    box.AlwaysOnTop = true
    box.ZIndex = 5
    box.Color3 = Color3.fromRGB(240, 248, 255)
    box.Transparency = 0.5
    box.Size = obj.Size
    box.Parent = CoreGui
    PCLDEsp.boxes[obj] = box
    obj.AncestryChanged:Connect(function(_, parent)
        if not parent and PCLDEsp.boxes[obj] then
            PCLDEsp.boxes[obj]:Destroy()
            PCLDEsp.boxes[obj] = nil
        end
    end)
end

local function RemoveAllPCLDBoxes()
    for obj, box in pairs(PCLDEsp.boxes) do
        if box and box.Parent then
            box:Destroy()
        end
    end
    PCLDEsp.boxes = {}
end

local function ScanPCLD()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if PCLDEsp.enabled and IsPCLDTarget(obj) then
            AddPCLDBox(obj)
        end
    end
end

